# --- PayKings ---
# Public merchant identifier (safe to expose in the browser).
NEXT_PUBLIC_PAYKINGS_MERCHANT_ID=

# Secret API / security key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
PAYKINGS_API_KEY=

# Gateway endpoint provided by PayKings (confirm the exact URL in your merchant portal).
PAYKINGS_API_URL=https://paykings.transactiongateway.com/api/transact.php

# Optional: set to "true" to simulate approved payments without calling PayKings
# (useful for previews). Never enable in production.
PAYKINGS_DEMO_MODE=false
